NODE_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=4000
BACKEND_API_BASE_PATH=/api/v1
LOG_LEVEL=info

# --- Database (Supabase / Postgres) ---
DATABASE_URL=postgresql://postgres.your-ref:password@aws-region.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# --- AI Assistant (MiniMax M3 via NVIDIA NIM) ---
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_MODEL=minimaxai/minimax-m3
MINIMAX_API_URL=https://integrate.api.nvidia.com/v1/chat/completions

# --- AI Assistant (Gemini — fallback) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- SMS Provider ---
# Set SMS_PROVIDER to one of: msg91 | fast2sms | twilio | stub
SMS_PROVIDER=twilio
MSG91_AUTH_KEY=
MSG91_SENDER_ID=IVA
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
TWILIO_MESSAGING_SERVICE_SID=your-messaging-service-sid
DEV_OTP_BYPASS=true

# --- Admin ---
ADMIN_SECRET_KEY=change-me-in-production

# --- Data Ingestion ---
CSV_IMPORT_DIR=./data/imports
CSV_ARCHIVE_DIR=./data/archive
INGESTION_BATCH_SIZE=50
QUEUE_POLL_INTERVAL_MS=5000
INGESTION_WORKER_ENABLED=true
